{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build paper",
            "type": "shell",
            "command": "make paper",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$tex-chktex"],
            "presentation": {
                "echo": true, "reveal": "always", "focus": false,
                "panel": "dedicated", "showReuseMessage": false, "clear": true
            }
        },
        {
            "label": "Run all notebooks (CPU + GPU)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output bash -c 'make sim'",
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Run GPU notebooks only (04b, 08)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output bash -c 'make sim-gpu'",
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Launch Streamlit dashboard (Tailscale)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output bash -c 'make app'",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "new" }
        },
        {
            "label": "Print dashboard URL",
            "type": "shell",
            "command": "make app-tunnel",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": false }
        },
        {
            "label": "Run tests (CPU)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output python -m pytest -q --ignore=tests/test_gpu_smoke.py",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Run GPU tests (RTX 5090 smoke)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output python -m pytest tests/test_gpu_smoke.py -v",
            "group": "test",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Benchmark (CPU vs GPU SDE)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output bash -c 'make bench'",
            "group": "test",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        },
        {
            "label": "Lint (ruff + mypy)",
            "type": "shell",
            "command": "conda run -n dcrisk-gpu --no-capture-output bash -c 'ruff check src tests && mypy src'",
            "group": "test",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
