{
    // ------------------------------------------------------------------
    // Python interpreter (adu-00 / dcrisk-gpu env)
    // ------------------------------------------------------------------
    "python.defaultInterpreterPath": "/home/adu-00/conda-envs/dcrisk-gpu/bin/python",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.extraPaths": ["${workspaceFolder}/src"],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],

    // ------------------------------------------------------------------
    // Integrated-terminal env: keep JAX from grabbing all 32 GB on import,
    // and pin CUDA visibility to device 0 (the only GPU on this box).
    // ------------------------------------------------------------------
    "terminal.integrated.env.linux": {
        "XLA_PYTHON_CLIENT_PREALLOCATE": "false",
        "CUDA_VISIBLE_DEVICES": "0"
    },

    // ------------------------------------------------------------------
    // Format on save: Black + isort + Ruff
    // ------------------------------------------------------------------
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },
    "black-formatter.args": ["--line-length", "100"],
    "isort.args": ["--profile", "black", "--line-length", "100"],
    "ruff.lint.args": [
        "--config",
        "${workspaceFolder}/pyproject.toml"
    ],
    "notebook.defaultFormatter": "ms-python.black-formatter",
    "notebook.formatOnSave.enabled": true,
    "jupyter.askForKernelRestart": false,

    // ------------------------------------------------------------------
    // LaTeX Workshop — build into paper/build/ from inside paper/
    // ------------------------------------------------------------------
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": ["-pdf", "-interaction=nonstopmode", "-file-line-error", "-synctex=1", "-shell-escape", "-outdir=build", "%DOC%"],
            "env": {}
        },
        {
            "name": "latexmk-clean",
            "command": "latexmk",
            "args": ["-c", "-outdir=build"],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        { "name": "latexmk (default)", "tools": ["latexmk"] }
    ],
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.search.rootFiles.include": ["paper/dc_paper.tex"],
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.autoBuild.run": "onSave",
    // External Evince — VS Code's built-in PDF.js tab renders the bone
    // background as near-white and washes the burnt-sienna accents; Evince
    // (Poppler) renders the file identically to the CLI latexmk build.
    "latex-workshop.view.pdf.viewer": "external",
    "latex-workshop.view.pdf.external.viewer.command": "evince",
    "latex-workshop.view.pdf.external.viewer.args": ["%PDF%"],
    "latex-workshop.view.pdf.external.synctex.command": "evince",
    "latex-workshop.view.pdf.external.synctex.args": ["%PDF%"],
    "latex-workshop.view.pdf.invertMode.enabled": "auto",
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.synctex.synctexjs.enabled": false,
    "latex-workshop.latex.autoClean.run": "onBuilt",
    // Note: `*.synctex.gz` deliberately NOT in this list — Evince needs it
    // for forward/inverse search and we want it to survive autoClean.
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux", "*.bbl", "*.blg", "*.idx", "*.ind", "*.lof", "*.lot",
        "*.out", "*.toc", "*.acn", "*.acr", "*.alg", "*.glg", "*.glo",
        "*.gls", "*.fls", "*.log", "*.fdb_latexmk", "*.snm", "*.nav",
        "*.vrb", "*.synctex(busy)", "*.run.xml", "*.bcf"
    ],
    "latex-workshop.latexindent.path": "latexindent",
    "latex-workshop.message.update.show": false,

    // ------------------------------------------------------------------
    // LTeX (grammar/style for LaTeX + Markdown)
    // ------------------------------------------------------------------
    "ltex.language": "en-GB",
    "ltex.disabledRules": {
        "en-GB": ["EN_QUOTES", "PASSIVE_VOICE"]
    },
    "ltex.additionalRules.enablePickyRules": false,

    // ------------------------------------------------------------------
    // Spell-check — dcrisk-specific dictionary
    // ------------------------------------------------------------------
    "cSpell.words": [
        "actuarial",
        "adu",
        "alidenewade",
        "Arrhenius",
        "ASHRAE",
        "Boltzmann",
        "CircuiTikZ",
        "copula",
        "copulas",
        "Cox",
        "Cramer",
        "CuPy",
        "cupy",
        "dcrisk",
        "Denewade",
        "Deg",
        "diffrax",
        "equinox",
        "Esscher",
        "Gumbel",
        "hyperscale",
        "ipykernel",
        "JAX",
        "jaxlib",
        "jaxtyping",
        "Kolmogorov",
        "kpsewhich",
        "latexmk",
        "lifelines",
        "Lognormal",
        "Lundberg",
        "Markov",
        "MERIDIAN",
        "miniconda",
        "optax",
        "papermill",
        "pgfplots",
        "Pigouvian",
        "pyextremes",
        "siunitx",
        "Solvency",
        "stochastic",
        "tailnet",
        "tailscale",
        "tcolorbox",
        "texlive",
        "tikz",
        "Tier",
        "tocloft",
        "TVaR",
        "Witwatersrand",
        "Wits"
    ],
    "cSpell.languageSettings": [
        { "languageId": "latex", "allowCompoundWords": true }
    ],

    // ------------------------------------------------------------------
    // File explorer hygiene — hide build artefacts from the tree
    // ------------------------------------------------------------------
    "files.exclude": {
        "**/__pycache__":        true,
        "**/.pytest_cache":      true,
        "**/.mypy_cache":        true,
        "**/.ruff_cache":        true,
        "**/.ipynb_checkpoints": true,
        "**/*.egg-info":         true,
        "**/.jax_cache":         true
    },
    "search.exclude": {
        "paper/build/**": true,
        "**/__pycache__": true,
        "**/.*_cache":    true
    },

    // ------------------------------------------------------------------
    // Editor defaults
    // ------------------------------------------------------------------
    "editor.rulers": [100],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true
}
