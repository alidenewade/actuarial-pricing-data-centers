{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Streamlit dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/src/dcrisk/dashboards/streamlit_app.py",
                "--server.headless=true"
            ],
            "python": "/home/ali/miniconda3/envs/dcrisk/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: pytest (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-q", "-s"],
            "python": "/home/ali/miniconda3/envs/dcrisk/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: pytest (all tests)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-q", "-s"],
            "python": "/home/ali/miniconda3/envs/dcrisk/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: pytest (current test under cursor)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}::${selectedText}", "-q", "-s"],
            "python": "/home/ali/miniconda3/envs/dcrisk/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "/home/ali/miniconda3/envs/dcrisk/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}
